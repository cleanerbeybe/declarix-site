{
  "name": "declarix-site",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run test:economics && npm run test:roi && npm run test:eori && npm run test:generators && npm run test:trade-tools && npm run test:procedures && tsc -b && vite build && node scripts/generate-static-routes.mjs && node scripts/agent-layer.mjs && node scripts/verify-build.mjs",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/verify-build.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "radar:check": "node scripts/radar-check-sources.mjs",
    "test:economics": "node --test tests/preparation-economics.test.mjs",
    "test:roi": "node --test tests/roi-calculator.test.mjs tests/value-duty-workpapers.test.mjs",
    "test:calculators:browser": "node tests/calculators.browser.cjs",
    "test:eori": "node --test tests/eori-checker.test.mjs",
    "test:eori:browser": "node tests/eori-checker.browser.cjs",
    "test:generators": "node --test tests/document-generators.test.mjs",
    "test:generators:browser": "node tests/document-generators.browser.cjs",
    "test:trade-tools": "node --test tests/trade-tools-*.test.mjs",
    "test:procedures": "node --test tests/customs-procedures.test.mjs",
    "test:procedures:browser": "node tests/customs-procedures.browser.cjs",
    "test:economics:browser": "node tests/preparation-economics.browser.cjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "oxlint": "^1.71.0",
    "playwright": "1.61.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
