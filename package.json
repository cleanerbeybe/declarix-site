{
  "name": "declarix-site",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run test:economics && npm run test:customer-workflows && tsc -b && vite build && node scripts/generate-static-routes.mjs && node scripts/verify-build.mjs",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/verify-build.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "test:economics": "node --test tests/preparation-economics.test.mjs",
    "test:economics:browser": "node tests/preparation-economics.browser.cjs",
    "test:customer-workflows": "node --test tests/customer-workflows.test.mjs",
    "test:customer-workflows:browser": "node tests/customer-workflows.browser.cjs",
    "preview:customer-workflows": "npm run build && node scripts/preview-customer-workflows.mjs",
    "test:customer-workflows:release": "node --test tests/customer-workflow-release.test.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "axe-core": "4.12.1",
    "oxlint": "^1.71.0",
    "playwright": "1.61.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
